# ---------------------------------------------------------------------------
# CUPS Raster v2 / v3 Reader
# ---------------------------------------------------------------------------

def _decode_cups_v2_plane(fp: BinaryIO, target_bytes: int) -> bytes:
    out = bytearray()
    while len(out) < target_bytes:
        b = fp.read(1)
        if not b:
            break
        n = b[0]
        if n <= 127:
            count = n + 1
            val = fp.read(1)
            if not val:
                break
            out.extend(val * count)
        else:
            count = 257 - n
            lit = fp.read(count)
            if not lit:
                break
            out.extend(lit)
    return bytes(out[:target_bytes])


def _decode_cups_v2_pixel_row(fp: BinaryIO, width: int, bpp: int) -> bytes:
    target = width * bpp
    out = bytearray()
    while len(out) < target:
        b = fp.read(1)
        if not b:
            break
        n = b[0]
        if n <= 127:
            count = n + 1
            px = fp.read(bpp)
            if not px:
                break
            out.extend(px * count)
        else:
            count = 257 - n
            lit = fp.read(count * bpp)
            if not lit:
                break
            out.extend(lit)
    return bytes(out[:target])


def read_cups_raster_page(fp: BinaryIO) -> Optional[Tuple[Image.Image, Dict[str, int]]]:
    """
    Read one page from a CUPS Raster v2 (RaS2/2SaR) or v3 (RaS3/3SaR) stream.
    Returns (PIL.Image in RGB mode, header_dict) or None on EOF.
    """
    hdr = fp.read(1796)
    if len(hdr) < 1796:
        return None

    # Offsets in cups_page_header2_t (big-endian or little-endian depending on sync word)
    # Sync word is read once at stream start before calling read_cups_raster_page.
    return None


class CupsRasterReader:
    def __init__(self, fp: BinaryIO):
        self.fp = fp
        sync = fp.read(4)
        if not sync or len(sync) < 4:
            self.valid = False
            return
        self.valid = True
        if sync in (b"RaS2", b"RaS3"):
            self.endian = ">"
            self.version = 2 if sync == b"RaS2" else 3
        elif sync in (b"2SaR", b"3SaR"):
            self.endian = "<"
            self.version = 2 if sync == b"2SaR" else 3
        else:
            raise ValueError(f"Unsupported CUPS Raster magic: {sync!r}")

    def read_next_page(self) -> Optional[Tuple[Image.Image, dict]]:
        if not self.valid:
            return None
        hdr = self.fp.read(1796)
        if len(hdr) < 1796:
            return None

        # cups_page_header2_t layout:
        # 0..255: 4 x 64-byte strings (MediaClass, MediaColor, MediaType, OutputType)
        # 256..403: 37 uint32 fields starting at offset 256:
        #   256: AdvanceDistance, 260: AdvanceMedia, 264: Collate, 268: CutMedia,
        #   272: Duplex, 276: HWResolution[0], 280: HWResolution[1],
        #   284..299: ImagingBoundingBox[4], 300: InsertSheet, 304: Jog,
        #   308: LeadingEdge, 312..319: Margins[2], 320: ManualFeed,
        #   324: MediaPosition, 328: MediaWeight, 332: MirrorPrint,
        #   336: NegativePrint, 340: NumCopies, 344: Orientation,
        #   348: OutputFaceUp, 352..359: PageSize[2], 360: Separations,
        #   364: TraySwitch, 368: Tumble, 372: cupsWidth, 376: cupsHeight,
        #   380: cupsMediaType, 384: cupsBitsPerColor, 388: cupsBitsPerPixel,
        #   392: cupsBytesPerLine, 396: cupsColorOrder, 400: cupsColorSpace
        u32 = struct.unpack_from(f"{self.endian}37I", hdr, 256)
        hw_res_x, hw_res_y = u32[5], u32[6]
        page_w_pt, page_h_pt = u32[24], u32[25]
        width, height = u32[29], u32[30]
        bpc, bpp, bpl = u32[32], u32[33], u32[34]
        color_space = u32[36]

        bytes_per_pixel = max(1, bpp // 8)
        raw_rows = bytearray()
        for _ in range(height):
            if self.version == 3:
                row = self.fp.read(bpl)
                raw_rows.extend(row[: width * bytes_per_pixel])
            else:
                row = _decode_cups_v2_pixel_row(self.fp, width, bytes_per_pixel)
                raw_rows.extend(row)

        if bytes_per_pixel == 3:
            img = Image.frombytes("RGB", (width, height), bytes(raw_rows))
        elif bytes_per_pixel == 4:
            img = Image.frombytes("RGBA", (width, height), bytes(raw_rows)).convert("RGB")
        elif bytes_per_pixel == 1:
            # Grayscale (W / sGray)
            img = Image.frombytes("L", (width, height), bytes(raw_rows)).convert("RGB")
        else:
            raise ValueError(f"Unsupported CUPS bits per pixel: {bpp}")

        meta = {
            "hw_res_x": hw_res_x,
            "hw_res_y": hw_res_y,
            "page_w_pt": page_w_pt,
            "page_h_pt": page_h_pt,
            "width": width,
            "height": height,
            "color_space": color_space,
        }
        return img, meta


# ---------------------------------------------------------------------------
# Small 1.8 x 1.8 cm Calibration / Verification Test Strip Generator
# ---------------------------------------------------------------------------

# 10 diagnostic color patches (<= 1.8 x 1.8 cm each to save ink!)
SMALL_PATCHES_RGB: List[Tuple[str, Tuple[int, int, int]]] = [
    ("PK/MK",  (  0,   0,   0)),
    ("LK",     (110, 110, 110)),
    ("LLK",    (190, 190, 190)),
    ("Cyan",   (  0, 255, 255)),
    ("Mag",    (255,   0, 255)),
    ("Yellow", (255, 255,   0)),
    ("Red",    (255,   0,   0)),
    ("Green",  (  0, 255,   0)),
    ("Blue",   (  0,   0, 255)),
    ("Violet", ( 96,   0, 255)),
]


def build_small_test_strip_image(print_w: int) -> Image.Image:
    """
    Create a compact 1.8 x 1.8 cm (510 x 510 px @ 720 dpi) 10-patch row at the
    top of the printable area so that very little ink is consumed and trailing
    blank bands are skipped automatically.
    """
    patch_px = 510    # 510 / 720 inch = 18.0 mm (1.8 x 1.8 cm, < 2 x 2 cm)
    gap_px = 56       # ~2.0 mm gap between patches
    top_pad = 64      # ~2.2 mm from top margin
    bottom_pad = 32
    img_h = ((top_pad + patch_px + bottom_pad + 15) // 16) * 16

    img = Image.new("RGB", (print_w, img_h), (255, 255, 255))
    draw = ImageDraw.Draw(img)

    total_strip_w = len(SMALL_PATCHES_RGB) * patch_px + (len(SMALL_PATCHES_RGB) - 1) * gap_px
    x0_start = max(16, (print_w - total_strip_w) // 2)

    for idx, (_label, rgb) in enumerate(SMALL_PATCHES_RGB):
        x0 = x0_start + idx * (patch_px + gap_px)
        x1 = min(print_w - 1, x0 + patch_px)
        y0 = top_pad
        y1 = top_pad + patch_px
        draw.rectangle([x0, y0, x1, y1], fill=rgb, outline=(80, 80, 80), width=2)

    return img


