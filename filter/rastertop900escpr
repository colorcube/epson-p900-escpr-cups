def build_lcd_thumbnail_jpeg(img: Image.Image, print_w: int, print_h: int) -> bytes:
    """
    Build the 272-px-tall (rotated 90° CCW) baseline JPEG thumbnail for the
    SC-P900's 480x272 LCD touchscreen ('ESC t tsnd').
    """
    import io

    portrait_w = 272
    portrait_h = max(16, int(round(272.0 * print_h / max(1, print_w))))
    thumb = Image.new("RGB", (portrait_w, portrait_h), (255, 255, 255))

    src_rgb = img if img.mode == "RGB" else img.convert("RGB")
    crop_w = min(src_rgb.width, print_w)
    crop_h = min(src_rgb.height, print_h)
    scaled_w = max(1, min(portrait_w, int(round(crop_w * portrait_w / max(1, print_w)))))
    scaled_h = max(1, min(portrait_h, int(round(crop_h * portrait_h / max(1, print_h)))))
    sub = src_rgb.crop((0, 0, crop_w, crop_h)).resize(
        (scaled_w, scaled_h), Image.Resampling.BILINEAR
    )
    thumb.paste(sub, (0, 0))

    rotated = thumb.transpose(Image.Transpose.ROTATE_90)
    buf = io.BytesIO()
    rotated.save(buf, "JPEG", quality=95, subsampling=2, restart_marker_blocks=4)
    return buf.getvalue()


def render_pil_image_to_escpr(
    img: Image.Image,
    cfg: EscprJobConfig,
    rendering_intent: str = "RelativeBPC",
    fit_to_page: bool = False,
) -> bytes:
    paper = get_paper_size(cfg.page_size, cfg.custom_w_720, cfg.custom_h_720)
    margin_lr, margin_tb = get_slot_margins_720(cfg.input_slot, cfg.borderless, cfg.margin_720)
    # Ensure print_w is aligned to 8 pixels so hardware RHV2 stride == print_w
    raw_print_w = paper.width_720 - 2 * margin_lr
    print_w = (raw_print_w // 8) * 8
    print_h = paper.height_720 - 2 * margin_tb

    # Place or scale image onto the 720 dpi printable canvas first
    if fit_to_page and (img.width != print_w or img.height != print_h):
        src_icc = img.info.get("icc_profile")
        img = img.resize((print_w, print_h), Image.Resampling.LANCZOS)
        if src_icc:
            img.info["icc_profile"] = src_icc
    elif img.width != print_w:
        src_icc = img.info.get("icc_profile")
        canvas_h = min(print_h, ((img.height + 15) // 16) * 16)
        canvas = Image.new("RGB", (print_w, canvas_h), (255, 255, 255))
        canvas.paste(img.crop((0, 0, min(img.width, print_w), canvas_h)), (0, 0))
        if src_icc:
            canvas.info["icc_profile"] = src_icc
        img = canvas

    # Generate LCD preview thumbnail BEFORE printer ICC conversion so colors on
    # the printer's display remain in standard display RGB.
    thumb_jpg = build_lcd_thumbnail_jpeg(img, print_w, print_h)

    # Apply Epson ICC profile when ColorMode == EpsonICC
    if cfg.color_mode.lower() == "epsonicc":
        sys.stderr.write(
            f"INFO: Applying Epson ICC profile for media '{cfg.media}' "
            f"(intent={rendering_intent}, LUT=4 No Color Adjustment)\n"
        )
        img = apply_epson_icc_to_image(img, cfg.media, rendering_intent=rendering_intent)
    else:
        if img.mode != "RGB":
            img = img.convert("RGB")

    raw_bytes = img.tobytes()
    row_stride = print_w * 3
    rows = [
        raw_bytes[y * row_stride : (y + 1) * row_stride]
        for y in range(min(img.height, print_h))
    ]
    return encode_rgb_page_to_escpr(
        rows,
        print_w,
        print_h,
        cfg,
        skip_trailing_blank=True,
        thumbnail_jpeg=thumb_jpg,
    )


def parse_cups_options(opt_str: str) -> Dict[str, str]:
    opts: Dict[str, str] = {}
    for token in shlex.split(opt_str or ""):
        if "=" in token:
            k, v = token.split("=", 1)
            opts[k] = v
        elif token.startswith("no"):
            opts[token[2:]] = "False"
        else:
            opts[token] = "True"
    return opts


def run_cups_filter_mode(argv: List[str]) -> int:
    job_id = argv[1]
    user = argv[2]
    title = argv[3]
    _copies = argv[4]
    opts = parse_cups_options(argv[5])

    fp: BinaryIO
    if len(argv) >= 7 and argv[6] != "-":
        fp = open(argv[6], "rb")
    else:
        fp = sys.stdin.buffer

    raw_cm = opts.get("EpsonColorMode", opts.get("ColorMode", ""))
    cm_calib = opts.get("cm-calibration", "False").lower() in ("true", "1", "yes", "on")
    if not raw_cm:
        color_mode = "NoColorAdjustment" if cm_calib else "EpsonICC"
    elif cm_calib and raw_cm.lower() == "epsonicc":
        # Standard CUPS cm-calibration=true overrides default EpsonICC to prevent double-profiling
        color_mode = "NoColorAdjustment"
    else:
        color_mode = raw_cm

    def _opt_int(keys: List[str]) -> Optional[int]:
        for k in keys:
            if k in opts:
                try:
                    return int(opts[k])
                except ValueError:
                    pass
        return None

    def _opt_bool(keys: List[str]) -> Optional[bool]:
        for k in keys:
            if k in opts:
                val = opts[k].lower()
                if val in ("auto", "default", ""):
                    continue
                return val in ("true", "1", "yes", "on")
        return None

    ignore_mismatch_opt = _opt_bool(["IgnorePanelMismatch", "EpsonIgnorePanelMismatch"])
    cfg = EscprJobConfig(
        media=opts.get("MediaType", opts.get("media", "PlainPaper")),
        input_slot=opts.get("InputSlot", "Rear"),
        page_size=opts.get("PageSize", opts.get("media", "A4")),
        quality=opts.get("PrintQuality", "High"),
        color_mode=color_mode,
        overcoat=opts.get("EpsonOverCoat", opts.get("OverCoat", "Auto")),
        borderless=opts.get("Borderless", "False").lower() in ("true", "1", "yes", "on"),
        unidirectional=opts.get("Unidirectional", "False").lower() in ("true", "1", "yes", "on"),
        job_name=(title or f"Job_{job_id}")[:60],
        job_user=(user or "linux")[:31],
        job_host=socket.gethostname()[:31],
        user_media_id=_opt_int(["UserMediaID", "CustomMediaSlot", "EpsonUserMediaID"]) or 0,
        print_duty=_opt_int(["PrintDuty", "ColorDensity", "EpsonPrintDuty"]),
        drying_time=_opt_int(["DryingTime", "EpsonDryingTime"]),
        bottom_edge_priority=_opt_bool(["BottomEdgePriority", "EpsonBottomEdgePriority"]),
        rubbing_reduction=_opt_int(["RubbingReduction", "EpsonRubbingReduction"]),
        ignore_panel_mismatch=True if ignore_mismatch_opt is None else ignore_mismatch_opt,
    )
    rendering_intent = opts.get("EpsonRenderingIntent", opts.get("RenderingIntent", "RelativeBPC"))

    reader = CupsRasterReader(fp)
    page_num = 0
    while True:
        res = reader.read_next_page()
        if res is None:
            break
        img, _meta = res
        page_num += 1
        sys.stderr.write(f"PAGE: {page_num} 1\n")
        prn_bytes = render_pil_image_to_escpr(
            img,
            cfg,
            rendering_intent=rendering_intent,
            fit_to_page=False,
        )
        sys.stdout.buffer.write(prn_bytes)
        sys.stdout.buffer.flush()

    if fp is not sys.stdin.buffer:
        fp.close()
    return 0


def run_cli_mode(argv: List[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Epson SC-P900 / SC-P700 ESC/P-R Level 5 + Official ICC Driver"
    )
    parser.add_argument("--image", help="Input RGB image file (PNG/TIFF/JPEG)")
    parser.add_argument(
        "--test-strip",
        action="store_true",
        help="Generate compact 1.8x1.8 cm 10-patch calibration strip on A4",
    )
    parser.add_argument("--media", default="PlainPaper", help="MediaType key (e.g. PlainPaper, PremiumGlossy, UltraSmoothFineArt)")
    parser.add_argument("--input-slot", default="Rear", choices=["Rear", "FrontFineArt", "FrontThick", "FrontPosterBoard", "FrontNoEjectRoller", "Roll"])
    parser.add_argument("--page-size", default="A4", help="Paper size (A4, A3, A3Plus, A2, 4x6, 5x7, 8x10, Letter, ...)")
    parser.add_argument("--quality", default="High", choices=["Normal", "Fine", "High", "Max", "CarbonBlack"])
    parser.add_argument("--color-mode", default="EpsonICC", choices=["EpsonICC", "NoColorAdjustment", "EpsonStandard", "AdvancedBW"])
    parser.add_argument("--intent", default="RelativeBPC", choices=["RelativeBPC", "RelativeNoBPC", "Perceptual", "Saturation", "Absolute"])
    parser.add_argument("--overcoat", default="Auto", choices=["Auto", "On", "Off"])
    parser.add_argument("--borderless", action="store_true")
    parser.add_argument("--unidirectional", action="store_true")
    parser.add_argument("--user-media-id", type=int, default=0, help="Custom media slot ID (1..30 or 1901..1930) emitted via ESC q setl")
    parser.add_argument("--print-duty", type=int, default=None, help="Color density / print duty adjustment (-50..+50) in ESC p setq")
    parser.add_argument("--drying-time", type=int, default=None, help="Drying time per pass (0..255) in REMOTE1 DR")
    parser.add_argument("--bottom-edge-priority", action="store_true", default=None, help="Enable bottom edge print quality priority in ESC m seti")
    parser.add_argument("--rubbing-reduction", type=int, default=None, help="Rubbing reduction value in ESC m seti")
    parser.add_argument("-o", "--output", help="Output .prn file path (default: stdout)")
    parser.add_argument("--send", help="Send generated job directly to printer host:port (e.g. 10.10.10.124:9100)")
    parser.add_argument("--image-width-mm", type=float, default=0.0, help="Scale --image to this printed width in mm (centered)")
    parser.add_argument("--image-top-mm", type=float, default=0.0, help="Distance of the scaled image from the top margin in mm")
    parser.add_argument("--image-left-mm", type=float, default=None, help="Distance of the image from the left (default: centered)")
    parser.add_argument("--image-height-mm", type=float, default=0.0, help="Printed height in mm (default: keep aspect ratio)")
    parser.add_argument("--image-fit", choices=["fill", "stretch"], default="fill", help="When width+height given: center-crop (fill) or distort (stretch)")
    parser.add_argument("--from-paper-edge", action="store_true", help="Interpret top/left offsets relative to the paper edge instead of the printable area")
    args = parser.parse_args(argv[1:])

    default_job_name = pathlib.Path(args.image).stem[:60] if args.image else "Calibration_Strip"
    cfg = EscprJobConfig(
        media=args.media,
        input_slot=args.input_slot,
        page_size=args.page_size,
        quality=args.quality,
        color_mode=args.color_mode,
        overcoat=args.overcoat,
        borderless=args.borderless,
        unidirectional=args.unidirectional,
        job_name=default_job_name,
        job_user=os.environ.get("USER", "linux")[:31],
        job_host=socket.gethostname()[:31],
        user_media_id=args.user_media_id,
        print_duty=args.print_duty,
        drying_time=args.drying_time,
        bottom_edge_priority=args.bottom_edge_priority,
        rubbing_reduction=args.rubbing_reduction,
    )

    paper = get_paper_size(cfg.page_size)
    margin_lr, margin_tb = get_slot_margins_720(cfg.input_slot, cfg.borderless, cfg.margin_720)
    print_w = ((paper.width_720 - 2 * margin_lr) // 8) * 8

    if args.test_strip:
        img = build_small_test_strip_image(print_w)
    elif args.image:
        _src_raw = Image.open(args.image)
        src_icc = _src_raw.info.get("icc_profile")
        src = _src_raw.convert("RGB")
        if args.image_width_mm:
            mm = lambda v: int(round(v / 25.4 * 720))
            target_w = min(print_w, mm(args.image_width_mm))
            if args.image_height_mm:
                target_h = mm(args.image_height_mm)
                if args.image_fit == "fill":
                    # Center-crop source to target aspect ratio (like "Fill frame")
                    ta = target_w / target_h
                    sa = src.width / src.height
                    if sa > ta:
                        cw = int(round(src.height * ta)); x0 = (src.width - cw) // 2
                        src = src.crop((x0, 0, x0 + cw, src.height))
                    else:
                        ch = int(round(src.width / ta)); y0 = (src.height - ch) // 2
                        src = src.crop((0, y0, src.width, y0 + ch))
            else:
                target_h = int(round(src.height * target_w / src.width))
            src = src.resize((target_w, target_h), Image.Resampling.LANCZOS)
            # Offsets are measured from the PAPER edge if --image-left-mm is given,
            # otherwise the image is centered; printable area starts at `margin`.
            top_px = max(0, mm(args.image_top_mm) - (margin_tb if args.from_paper_edge else 0))
            if args.image_left_mm is not None:
                left_px = max(0, mm(args.image_left_mm) - (margin_lr if args.from_paper_edge else 0))
            else:
                left_px = (print_w - target_w) // 2
            img = Image.new("RGB", (print_w, top_px + target_h), (255, 255, 255))
            img.paste(src, (left_px, top_px))
        else:
            img = src
        if src_icc:
            img.info["icc_profile"] = src_icc
    else:
        parser.error("Specify either --test-strip or --image <file>")
        return 1

    prn_bytes = render_pil_image_to_escpr(
        img,
        cfg,
        rendering_intent=args.intent,
        fit_to_page=False,
    )

    if args.output:
        out_path = pathlib.Path(args.output)
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_bytes(prn_bytes)
        media_spec = get_media_spec(cfg.media)
        sys.stderr.write(
            f"Wrote {out_path} ({len(prn_bytes):,} bytes) | "
            f"Media={media_spec.name} (SN={media_spec.sn_id}, ICC={media_spec.icc_profile}) | "
            f"Quality={cfg.quality} | ColorMode={cfg.color_mode}\n"
        )

    if args.send:
        host, _, port_s = args.send.partition(":")
        port = int(port_s) if port_s else 9100
        sys.stderr.write(f"Sending {len(prn_bytes):,} bytes to {host}:{port} ...\n")
        with socket.create_connection((host, port), timeout=30) as sock:
            # Timeout only for connect: the printer throttles the data stream
            # (paper feed, head cleaning, drying) and may stall for minutes.
            sock.settimeout(None)
            sock.sendall(prn_bytes)
        sys.stderr.write("Sent successfully.\n")

    if not args.output and not args.send:
        sys.stdout.buffer.write(prn_bytes)

    return 0


def main() -> int:
    if len(sys.argv) in (6, 7) and not sys.argv[1].startswith("-"):
        return run_cups_filter_mode(sys.argv)
    return run_cli_mode(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
